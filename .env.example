# Skopiuj ten plik jako .env i uzupełnij.

# Token bota z https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# ID serwerów (PPM na serwer -> "Kopiuj ID serwera"; wymaga trybu dewelopera w Discordzie).
# Komendy pojawiają się na nich od razu. Gdy oba puste - komendy są rejestrowane globalnie.
# Serwer główny (produkcyjny) - tu bot działa dla użytkowników
GUILD_ID=
# Serwer developerski - tu testujesz bota
DEV_GUILD_ID=

# (opcjonalnie) listy domen phishingowych pobierane automatycznie, oddzielone przecinkami.
# Obsługiwane formaty: JSON {"domains": [...]}, JSON [...] albo tekst (jedna domena w linii).
PHISHING_LIST_URLS=https://raw.githubusercontent.com/nikolaischunk/discord-phishing-links/main/domain-list.json

# Co ile godzin odświeżać listy
PHISHING_LIST_REFRESH_HOURS=6

# --- Odpowiedzi AI (Google Gemini) ---
# Klucz API z https://aistudio.google.com/apikey (bez niego bot nie odpowiada na pytania)
GEMINI_API_KEY=

# (opcjonalnie) model Gemini
GEMINI_MODEL=gemini-3.8-flash

# (opcjonalnie) zapasowe modele, gdy główny jest przeciążony lub bez limitu - po przecinku.
# Darmowy klucz: każdy model ma osobny limit ok. 20 pytań dziennie.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# (opcjonalnie) true = AI może szukać w Google aktualnych informacji
GEMINI_SEARCH=false

# --- Panel administracyjny "PEP Creators" (logowanie przez Discord) ---
# Client Secret z Developer Portal -> Twoja aplikacja -> OAuth2 -> Client Secret (Reset Secret)
# W tym samym miejscu dodaj Redirect: http://localhost:3000/auth/callback
DISCORD_CLIENT_SECRET=

# Port panelu lokalnego (0 = wyłączony). Domyślnie 3000, a z Supabase 0 (panel działa na Vercelu).
PANEL_PORT=3000

# (opcjonalnie) adres panelu, jeśli inny niż http://localhost:PORT
PANEL_URL=

# --- Wdrożenie: Supabase (wspólna baza bota na hostingu i panelu na Vercelu) ---
# Supabase -> Project Settings -> API: "Project URL" i klucz "service_role" (TAJNY - nigdy w przeglądarce/czacie).
# Puste = tryb lokalny (dane w folderze data/).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Klucz do podpisywania sesji panelu (min. 32 znaki). Ten sam ustaw na Vercelu.
PANEL_SESSION_SECRET=

# (opcjonalnie) false = bez czytania obrazków (oszczędza ok. 300 MB RAM na słabym hostingu)
OCR_ENABLED=true

# (opcjonalnie) godzina codziennego raportu na kanale raportów (czas polski)
REPORT_HOUR=20
